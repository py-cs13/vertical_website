# =============================================
# 母婴垂直网站 - 生产环境Docker Compose配置
# =============================================
# 版本：3.8
# 用途：生产环境完整部署方案
# 特点：安全、可靠、可扩展
# 作者：Trae AI Assistant
# 日期：2024年12月

version: '3.8'

# =============================================
# 网络配置 - 使用自定义网络
# =============================================
# 说明：创建专用网络隔离各服务，提高安全性
# 外部访问：通过Traefik反向代理统一入口
networks:
  # 内部服务网络
  app-network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16
    driver_opts:
      # 启用网络隔离
      com.docker.network.bridge.enable_icc: "true"
      com.docker.network.bridge.enable_ip_masquerade: "true"

# =============================================
# 数据卷配置 - 持久化存储
# =============================================
# 说明：使用命名卷持久化数据，便于备份和迁移
volumes:
  # PostgreSQL数据持久化卷
  postgres_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /home/ubuntu/docker/data/postgres
  
  # Redis数据持久化卷  
  redis_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /home/ubuntu/docker/data/redis

  # 后端静态文件卷
  backend_static:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /home/ubuntu/docker/data/backend/static

# =============================================
# 服务定义
# =============================================

# =============================================
# PostgreSQL数据库服务 - 生产配置
# =============================================
# 说明：生产级PostgreSQL配置，包含安全设置和性能优化
services:
  # PostgreSQL数据库服务
  postgres:
    # 使用官方PostgreSQL 15镜像（稳定版本）
    image: postgres:15-alpine
    
    # 容器名称
    container_name: vertical_website_postgres
    
    # 重启策略：容器异常退出时自动重启
    restart: unless-stopped
    
    # 网络配置：加入内部网络
    networks:
      - app-network
    
    # 端口映射：仅内部访问，不对外暴露
    # 如果需要本地连接数据库，请取消注释下面两行
    # ports:
    #   - "127.0.0.1:5432:5432"  # 本地PostgreSQL访问
    
    # 环境变量配置
    environment:
      # 数据库基础配置
      POSTGRES_DB: vertical_website
      POSTGRES_USER: vertical_user
      
      # 安全：使用强密码（生产环境建议使用环境变量文件）
      POSTGRES_PASSWORD: "VerticalWeb2024!@#$Secure"
      
      # PostgreSQL性能优化配置
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --locale=C"
      
      # 连接池配置
      PGDATA: /var/lib/postgresql/data/pgdata
      
      # 时区设置
      TZ: Asia/Shanghai
    
    # 挂载数据卷：持久化存储
    volumes:
      # PostgreSQL数据目录
      - postgres_data:/var/lib/postgresql/data
      
      # 挂载配置文件（如需要自定义配置）
      # - ./config/postgresql.conf:/etc/postgresql/postgresql.conf:ro
    
    # 健康检查：确保数据库服务正常运行
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U vertical_user -d vertical_website"]
      interval: 30s          # 检查间隔
      timeout: 10s           # 超时时间
      retries: 3             # 重试次数
      start_period: 40s      # 启动等待时间
    
    # 资源限制：防止资源耗尽
    deploy:
      resources:
        limits:
          # 内存限制：最大512MB
          memory: 512M
          # CPU限制：最大1核
          cpus: '1.0'
        reservations:
          # 内存保留：最小256MB
          memory: 256M
          # CPU保留：最小0.5核
          cpus: '0.5'
    
    # 日志配置
    logging:
      driver: "json-file"
      options:
        max-size: "10m"      # 单个日志文件最大10MB
        max-file: "3"        # 保留3个日志文件
    
    # 安全配置
    security_opt:
      - no-new-privileges:true
    
    # 用户配置：以非root用户运行
    user: "999:999"

# =============================================
# Redis缓存服务 - 生产配置  
# =============================================
# 说明：生产级Redis配置，包含安全设置和持久化
  redis:
    # 使用官方Redis 7镜像（稳定版本）
    image: redis:7-alpine
    
    # 容器名称
    container_name: vertical_website_redis
    
    # 重启策略
    restart: unless-stopped
    
    # 网络配置
    networks:
      - app-network
    
    # 端口映射：仅内部访问
    # 如果需要本地连接Redis，请取消注释下面两行
    # ports:
    #   - "127.0.0.1:6379:6379"  # 本地Redis访问
    
    # 环境变量配置
    environment:
      # Redis配置文件路径
      REDIS_PASSWORD: "Redis2024!@#$Secure"
      TZ: Asia/Shanghai
    
    # 挂载数据卷
    volumes:
      # Redis数据目录
      - redis_data:/data
      
      # Redis配置文件（如需要自定义配置）
      # - ./config/redis.conf:/usr/local/etc/redis/redis.conf:ro
    
    # 启动命令：使用配置文件
    command: >
      redis-server 
      --requirepass "Redis2024!@#$Secure"
      --appendonly yes
      --appendfsync everysec
      --maxmemory 256mb
      --maxmemory-policy allkeys-lru
      --tcp-keepalive 300
      --timeout 0
    
    # 健康检查
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    
    # 资源限制
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.5'
        reservations:
          memory: 128M
          cpus: '0.25'
    
    # 日志配置
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    
    # 安全配置
    security_opt:
      - no-new-privileges:true

# =============================================
# 后端API服务 - 生产配置
# =============================================
  backend:
    # 使用阿里云镜像（可根据需要替换为其他镜像源）
    image: registry.cn-hangzhou.aliyuncs.com/meta-jiujiu/website_backend:latest
    
    # 容器名称
    container_name: vertical_website_backend
    
    # 重启策略
    restart: unless-stopped
    
    # 网络配置
    networks:
      - app-network
    
    # 端口映射：内部8000端口映射到外部8000端口
    ports:
      - "8000:8000"
    
    # 环境变量配置
    environment:
      # 数据库连接配置
      DATABASE_URL: "postgresql://vertical_user:VerticalWeb2024!@#$Secure@postgres:5432/vertical_website"
      
      # Redis连接配置
      REDIS_URL: "redis://:Redis2024!@#$Secure@redis:6379/0"
      
      # 应用基础配置
      APP_NAME: "vertical_website"
      APP_VERSION: "1.0.0"
      ENVIRONMENT: "production"
      DEBUG: "false"
      
      # 安全配置
      SECRET_KEY: "YourSuperSecureSecretKey2024!@#$%"
      ACCESS_TOKEN_EXPIRE_MINUTES: "30"
      
      # JWT配置
      JWT_ALGORITHM: "HS256"
      JWT_SECRET_KEY: "JWT2024!@#$SuperSecureSecret"
      
      # API配置
      API_V1_STR: "/api"
      PROJECT_NAME: "母婴垂直网站"
      
      # CORS配置（根据前端域名调整）
      CORS_ORIGINS: "http://localhost:5173,http://localhost:3000,https://quzhinan.cn,https://backend.quzhinan.cn"
      
      # 文件上传配置
      UPLOAD_DIR: "/app/static"
      MAX_FILE_SIZE: "10485760"  # 10MB
      
      # 限流配置
      RATE_LIMIT_PER_MINUTE: "100"
      RATE_LIMIT_PER_HOUR: "1000"
      
      # 日志配置
      LOG_LEVEL: "INFO"
      LOG_FORMAT: "json"
      
      # 时区
      TZ: Asia/Shanghai
    
    # 服务依赖：确保数据库和Redis先启动
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    
    # 挂载数据卷
    volumes:
      # 静态文件目录
      - backend_static:/app/static
      
      # 配置文件目录（如需要）
      # - ./config/backend:/app/config:ro
    
    # 健康检查
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    
    # 资源限制
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '1.0'
        reservations:
          memory: 512M
          cpus: '0.5'
    
    # 日志配置
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
    
    # 安全配置
    security_opt:
      - no-new-privileges:true
    
    # 用户配置
    user: "1000:1000"

# =============================================
# 前端Web服务 - 生产配置
# =============================================
  frontend:
    # 使用阿里云镜像
    image: registry.cn-hangzhou.aliyuncs.com/meta-jiujiu/website_frontend:latest
    
    # 容器名称
    container_name: vertical_website_frontend
    
    # 重启策略
    restart: unless-stopped
    
    # 网络配置
    networks:
      - app-network
    
    # 端口映射：内部80端口映射到外部80端口
    ports:
      - "80:80"
    
    # 环境变量配置
    environment:
      # 后端API地址
      VITE_API_BASE_URL: "http://localhost:8000/api"
      
      # 应用配置
      VITE_APP_NAME: "母婴垂直网站"
      VITE_APP_VERSION: "1.0.0"
      
      # CDN配置（如使用CDN）
      VITE_CDN_URL: ""
      
      # 分析配置（如需要）
      VITE_GOOGLE_ANALYTICS_ID: ""
      
      # 时区
      TZ: Asia/Shanghai
    
    # 健康检查
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    
    # 资源限制
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.5'
        reservations:
          memory: 128M
          cpus: '0.25'
    
    # 日志配置
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    
    # 安全配置
    security_opt:
      - no-new-privileges:true
    
    # 用户配置
    user: "1000:1000"

# =============================================
# 配置说明文档
# =============================================

# 使用方法：
# 1. 创建数据目录：mkdir -p /home/ubuntu/docker/data/{postgres,redis,backend/static}
# 2. 设置目录权限：chmod 755 /home/ubuntu/docker/data/{postgres,redis,backend/static}
# 3. 启动服务：docker-compose up -d
# 4. 检查状态：docker-compose ps
# 5. 查看日志：docker-compose logs

# 安全特性：
# - 网络隔离：服务间使用专用网络
# - 资源限制：防止资源耗尽
# - 健康检查：自动监控服务状态
# - 容器重启：异常时自动恢复
# - 安全选项：禁用新权限提升
# - 非root用户：提高安全性

# 端口说明：
# - 前端：http://localhost:80 (或您的域名)
# - 后端API：http://localhost:8000/api
# - 数据库：仅内部访问，不对外暴露
# - Redis：仅内部访问，不对外暴露
# - 如需本地连接数据库/Redis，请取消对应端口注释

# 数据备份：
# - PostgreSQL：/home/ubuntu/docker/data/postgres
# - Redis：/home/ubuntu/docker/data/redis
# - 静态文件：/home/ubuntu/docker/data/backend/static

# 监控和维护：
# - 查看所有服务状态：docker-compose ps
# - 查看特定服务日志：docker-compose logs [service_name]
# - 重启服务：docker-compose restart [service_name]
# - 更新服务：docker-compose up -d [service_name]
# - 清理无用资源：docker system prune -f