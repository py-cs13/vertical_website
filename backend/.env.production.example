# 生产环境配置文件示例
# 复制此文件为.env.production并填写实际值

# 基本配置
APP_NAME="垂直领域内容变现平台API"
APP_VERSION="1.0.0"
DEBUG=false
APP_ENV=production

# 安全配置
SECRET_KEY=your_production_secret_key_here  # 使用强密钥，建议至少32字符
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库配置
# PostgreSQL连接字符串 - Docker Compose内部连接（容器间通信）
# DATABASE_URL=postgresql://vertical_user:pg123456@website_postgres:5432/vertical_website
# PostgreSQL连接字符串 - 外部连接（使用服务器IP）
DATABASE_URL=postgresql://vertical_user:pg123456@101.43.177.216:5432/vertical_website

# Redis配置
# Redis连接字符串（包含密码） - Docker Compose内部连接（容器间通信）
# REDIS_URL=redis://:redis123456@website_redis:6379/0
# Redis连接字符串（包含密码） - 外部连接（使用服务器IP）
REDIS_URL=redis://:redis123456@101.43.177.216:6379/0

# CSRF配置
CSRF_SECRET_KEY=your_production_csrf_secret_key_here
CSRF_COOKIE_SAMESITE=lax
CSRF_COOKIE_SECURE=true

# CORS配置
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 邮件配置（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_email_password
# FROM_EMAIL=your_email@example.com

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 支付宝支付配置
# 从支付宝开放平台获取：https://open.alipay.com/
ALIPAY_APP_ID=your_alipay_app_id_here
ALIPAY_APP_PRIVATE_KEY=your_alipay_app_private_key_here
ALIPAY_PUBLIC_KEY=your_alipay_public_key_here
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do  # 生产环境
# ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do  # 沙箱环境
ALIPAY_DEBUG=false  # 生产环境设置为false
ALIPAY_NOTIFY_URL=http://your_domain.com/api/payment/callback
ALIPAY_RETURN_URL=http://your_domain.com/payment-success

# 支付测试模式配置
PAYMENT_TEST_MODE=true  # 测试模式下，点击支付会直接模拟支付完成，跳过真实支付网关